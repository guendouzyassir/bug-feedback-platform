{% extends 'base.html.twig' %}

{% block title %}Not Found | FixFlow{% endblock %}
{% block topbar_title %}404{% endblock %}

{% block body %}
    <div class="empty-state" style="padding: 4rem 1rem; text-align: center;">
        <div class="empty-state-icon" style="font-size: 4rem; margin-bottom: 1rem;">404</div>
        <h2 style="margin-bottom: 0.5rem;">Page Not Found</h2>
        <p class="muted" style="margin-bottom: 1.5rem;">The bug report or page you're looking for doesn't exist or has been removed.</p>
        <a class="button" href="{{ path('app_bug_report_index') }}">Back to Bug Reports</a>
    </div>
{% endblock %}
