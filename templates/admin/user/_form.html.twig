{{ form_start(form, {'attr': {'class': 'form'}}) }}
    {{ form_row(form.email) }}
    {{ form_row(form.fullName) }}
    {{ form_row(form.role) }}
    <div class="flex items-center justify-between border border-[var(--line)] rounded-[var(--radius)] px-3 py-2 bg-[var(--bg)] hover:border-[#475569] hover:bg-[var(--bg-subtle)] transition-colors duration-200">
        <label for="{{ form.isActive.vars.id }}" class="text-[.8125rem] font-semibold text-[var(--text-secondary)] select-none cursor-pointer">
            {{ form.isActive.vars.label|default('Is active') }}
        </label>
        <label class="relative inline-block w-10 h-[1.375rem] flex-shrink-0 cursor-pointer">
            <input type="checkbox"
                   id="{{ form.isActive.vars.id }}"
                   name="{{ form.isActive.vars.full_name }}"
                   value="{{ form.isActive.vars.value }}"
                   {% if form.isActive.vars.checked %}checked{% endif %}
                   class="sr-only peer">
            <span class="absolute inset-0 bg-[#334155] rounded-full transition-colors duration-200 peer-checked:bg-[var(--accent)]"></span>
            <span class="absolute top-[3px] left-[3px] w-4 h-4 bg-white rounded-full transition-transform duration-200 peer-checked:translate-x-[1.125rem]"></span>
        </label>
    </div>
    {% do form.isActive.setRendered() %}
    {{ form_row(form.plainPassword) }}

    {% if form.clientProfile is defined %}
    <div id="client-profile-section">
        <fieldset class="form-fieldset">
            <legend>Client Profile</legend>
            {{ form_row(form.clientProfile.companyName) }}
            {{ form_row(form.clientProfile.phoneNumber) }}
            {{ form_row(form.clientProfile.companyAddress) }}
        </fieldset>
    </div>
    {% endif %}
    <script>
    (function() {
        var roleSelect = document.getElementById('{{ form.role.vars.id }}');
        var section = document.getElementById('client-profile-section');
        if (roleSelect && section) {
            section.style.display = roleSelect.value === 'ROLE_CLIENT' ? '' : 'none';
            roleSelect.addEventListener('change', function() {
                section.style.display = this.value === 'ROLE_CLIENT' ? '' : 'none';
            });
        }
    })();
    </script>

    <button class="btn">{{ button_label|default('Save User') }}</button>
{{ form_end(form) }}
