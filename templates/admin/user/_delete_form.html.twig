<form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" data-confirm="Delete this user account? Related bugs and comments will also be removed." data-confirm-title="Delete User?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="button button-sm button-danger">Delete</button>
</form>
