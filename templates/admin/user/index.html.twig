{% extends 'base.html.twig' %}

{% block title %}Users | FixFlow{% endblock %}
{% block topbar_title %}Users{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="muted">Create and manage accounts for admins, developers, clients, and testers.</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('app_admin_user_new') }}">New User</a>
        </div>
    </div>

    <section class="panel">
        {% if users is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">&#128100;</div>
                <p>No user accounts found.</p>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            {% set roles = user.roles %}
                            <tr>
                                <td><strong>{{ user.fullName }}</strong></td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% if 'ROLE_ADMIN' in roles %}
                                        <span class="badge badge-priority-critical"><span class="badge-dot"></span>Admin</span>
                                    {% elseif 'ROLE_DEVELOPER' in roles %}
                                        <span class="badge badge-priority-high"><span class="badge-dot"></span>Developer</span>
                                    {% elseif 'ROLE_CLIENT' in roles %}
                                        <span class="badge badge-priority-medium"><span class="badge-dot"></span>Client</span>
                                        {% if user.clientProfile %}
                                            <div class="muted" style="font-size:.8rem;margin-top:.2rem;">{{ user.clientProfile.companyName }}</div>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge">User</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {{ user.isActive ? 'badge-status-closed' : 'badge-status-rejected' }}"><span class="badge-dot"></span>{{ user.isActive ? 'Active' : 'Inactive' }}</span>
                                </td>
                                <td>{{ user.createdAt|date('Y-m-d') }}</td>
                                <td>
                                    <div class="actions">
                                        <a class="button button-sm button-secondary" href="{{ path('app_admin_user_edit', {'id': user.id}) }}">Edit</a>
                                        {% if app.user and app.user.id != user.id %}
                                            {% include 'admin/user/_delete_form.html.twig' with {user: user} %}
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}