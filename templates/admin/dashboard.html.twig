{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | FixFlow{% endblock %}
{% block topbar_title %}Admin Dashboard{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="muted">Project, bug, and workflow overview.</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('app_bug_report_index') }}">View Bugs</a>
            <a class="button button-secondary" href="{{ path('app_admin_project_index') }}">Projects</a>
            <a class="button button-secondary" href="{{ path('app_admin_user_index') }}">Users</a>
        </div>
    </div>

    <section class="quick-actions">
        <a class="quick-action" href="{{ path('app_admin_project_new') }}">
            <strong>New Project</strong>
            <span class="muted">Add a web, mobile, or API project.</span>
        </a>
        <a class="quick-action" href="{{ path('app_admin_project_index') }}">
            <strong>Manage Projects</strong>
            <span class="muted">Edit project details and status.</span>
        </a>
        <a class="quick-action" href="{{ path('app_bug_report_index') }}">
            <strong>Manage Bugs</strong>
            <span class="muted">Assign developers and update status.</span>
        </a>
        <a class="quick-action" href="{{ path('app_bug_report_new') }}">
            <strong>New Bug Report</strong>
            <span class="muted">Create a report during testing.</span>
        </a>
        <a class="quick-action" href="{{ path('app_admin_user_new') }}">
            <strong>New User</strong>
            <span class="muted">Create employee or client accounts.</span>
        </a>
        <a class="quick-action" href="{{ path('app_admin_user_index') }}">
            <strong>Manage Users</strong>
            <span class="muted">Edit roles, status, and passwords.</span>
        </a>
    </section>

    <section class="grid">
        <article class="metric">
            <div class="metric-label">Users</div>
            <span class="metric-value">{{ userCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Projects</div>
            <span class="metric-value">{{ projectCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Bug Reports</div>
            <span class="metric-value">{{ bugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Open</div>
            <span class="metric-value">{{ openBugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">In Progress</div>
            <span class="metric-value">{{ inProgressBugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Fixed</div>
            <span class="metric-value">{{ fixedBugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Critical</div>
            <span class="metric-value">{{ criticalBugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Unassigned</div>
            <span class="metric-value">{{ unassignedBugCount }}</span>
        </article>
    </section>

    <h2 class="section-title">Developer Performance</h2>

    <section class="stat-card" style="margin-bottom: 1.25rem;">
        <h2>Bugs Resolved Per Developer</h2>
        {% if developerStats is empty %}
            <div class="empty-state" style="padding: 1.5rem;">
                <p class="muted">No resolved bugs yet.</p>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Developer</th>
                            <th>Bugs Resolved</th>
                            <th>Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set maxCount = developerStats|first.count %}
                        {% for dev in developerStats %}
                            <tr>
                                <td><strong>{{ dev.fullName }}</strong></td>
                                <td>
                                    <span class="metric-value" style="font-size:1.1rem; margin:0;">{{ dev.count }}</span>
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:.6rem;">
                                        <div style="flex:1;height:6px;background:var(--bg-subtle);border-radius:3px;overflow:hidden;min-width:60px;">
                                            <div style="height:100%;width:{{ (dev.count / maxCount * 100)|round }}%;background:linear-gradient(90deg,var(--accent),var(--purple));border-radius:3px;transition:width .3s ease;"></div>
                                        </div>
                                        <span class="muted" style="font-size:.75rem;white-space:nowrap;">{{ ((dev.count / bugCount) * 100)|round }}%</span>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <h2 class="section-title">Time Tracking</h2>

    <section class="stat-card" style="margin-top: 1.25rem;">
        <h2>Time Spent Per Bug</h2>
        {% if timeSpentPerBug is empty %}
            <div class="empty-state" style="padding: 1.5rem;">
                <p class="muted">No time tracking data available yet.</p>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Bug</th>
                            <th>Developer</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Treated</th>
                            <th>Closed</th>
                            <th>Time Spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in timeSpentPerBug %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_bug_report_show', {'id': entry.bugId}) }}">#{{ entry.bugId }} {{ entry.title }}</a>
                                </td>
                                <td>{{ entry.developerName ?: 'Unassigned' }}</td>
                                <td>
                                    {% if entry.closedAt %}
                                        <span class="badge badge-status-closed"><span class="badge-dot"></span>Closed</span>
                                    {% elseif entry.treatedAt %}
                                        <span class="badge badge-status-in_progress"><span class="badge-dot"></span>In Progress</span>
                                    {% endif %}
                                </td>
                                <td>{{ entry.createdAt|date('Y-m-d') }}</td>
                                <td>{{ entry.treatedAt ? entry.treatedAt|date('Y-m-d') : '-' }}</td>
                                <td>{{ entry.closedAt ? entry.closedAt|date('Y-m-d') : '-' }}</td>
                                <td>
                                    {% if entry.timeSpentHours is not null %}
                                        {% set totalMinutes = (entry.timeSpentHours * 60)|round %}
                                        {% set h = (totalMinutes / 60)|round(0, 'floor') %}
                                        {% set m = totalMinutes % 60 %}
                                        <span class="badge" style="background:var(--accent-light);color:var(--accent);font-weight:650;">
                                            {% if h > 0 and m > 0 %}{{ h }}h {{ m }}m{% elseif h > 0 %}{{ h }}h{% else %}{{ m }}m{% endif %}
                                        </span>
                                    {% else %}
                                        <span class="muted">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
