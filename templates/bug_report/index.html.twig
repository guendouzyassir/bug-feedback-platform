{% extends 'base.html.twig' %}

{% block title %}Bug Reports | FixFlow{% endblock %}
{% block topbar_title %}Bug Reports{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Bug Reports</h1>
            <p class="muted">{{ scope_label }} &middot; {{ bug_reports|length }} total</p>
        </div>
        <div class="actions">
            <div class="view-toggle">
                <button class="view-toggle-btn active" data-view="kanban" onclick="switchView('kanban')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"/></svg>
                    Board
                </button>
                <button class="view-toggle-btn" data-view="table" onclick="switchView('table')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10h18M3 14h18M3 6h18M3 18h18"/></svg>
                    Table
                </button>
            </div>
            {% if is_granted('BUG_CREATE') %}
                <a class="btn" href="{{ path('app_bug_report_new') }}">New Bug Report</a>
            {% endif %}
        </div>
    </div>

    <section class="panel" style="margin-bottom: 1.5rem;">
        <form method="get" class="filters">
            <label>
                Keyword
                <input type="search" name="keyword" value="{{ filters.keyword }}" placeholder="Search title or description...">
            </label>
            <label>
                Project
                <select name="project">
                    <option value="">All projects</option>
                    {% for project in projects %}
                        <option value="{{ project.id }}" {{ filters.project == project.id ? 'selected' : '' }}>{{ project.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Status
                <select name="status">
                    <option value="">All statuses</option>
                    {% for status in statuses %}
                        <option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>{{ status.label() }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Priority
                <select name="priority">
                    <option value="">All priorities</option>
                    {% for priority in priorities %}
                        <option value="{{ priority.value }}" {{ filters.priority == priority.value ? 'selected' : '' }}>{{ priority.label() }}</option>
                    {% endfor %}
                </select>
            </label>
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_DEVELOPER') %}
                <label>
                    Developer
                    <select name="developer">
                        <option value="">All developers</option>
                        {% for developer in developers %}
                            <option value="{{ developer.id }}" {{ filters.developer == developer.id ? 'selected' : '' }}>{{ developer.fullName }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}
            <label>
                From
                <input type="date" name="dateFrom" value="{{ filters.dateFrom }}">
            </label>
            <label>
                To
                <input type="date" name="dateTo" value="{{ filters.dateTo }}">
            </label>
            <div class="filter-actions">
                <button class="btn">Filter</button>
                <a class="btn btn-secondary" href="{{ path('app_bug_report_index') }}">Reset</a>
            </div>
        </form>
    </section>

    <div id="view-kanban">
        {% set statusColumns = {
            'open': {'label': 'To Do', 'color': '#3B82F6'},
            'in_progress': {'label': 'In Development', 'color': '#8B5CF6'},
            'fixed': {'label': 'In Testing', 'color': '#60A5FA'},
            'closed': {'label': 'Completed', 'color': '#22C55E'},
            'rejected': {'label': 'Rejected', 'color': '#EF4444'}
        } %}

        <div class="kanban">
            {% for statusValue, col in statusColumns %}
                {% set colBugs = bug_reports|filter(b => b.status.value == statusValue) %}
                <div class="kanban-column">
                    <div class="kanban-column-header">
                        <div class="kanban-column-title">
                            <span class="kanban-column-dot" style="background: {{ col.color }};"></span>
                            {{ col.label }}
                        </div>
                        <span class="kanban-column-count">{{ colBugs|length }}</span>
                    </div>
                    <div class="kanban-column-body">
                        {% if colBugs is empty %}
                            <div class="kanban-empty">No bugs</div>
                        {% endif %}
                        {% for bug in colBugs %}
                            <a class="bug-card" href="{{ path('app_bug_report_show', {'id': bug.id}) }}">
                                <div class="bug-card-id">#{{ bug.id }}</div>
                                <div class="bug-card-title">{{ bug.title }}</div>
                                <div class="bug-card-meta">
                                    <span class="bug-card-priority bug-card-priority-{{ bug.priority.value }}">
                                        <span class="bug-card-priority-dot"></span>
                                        {{ bug.priority.label() }}
                                    </span>
                                </div>
                                <div class="bug-card-footer">
                                    <span class="bug-card-project">{{ bug.project.name }}</span>
                                    {% if bug.assignedDeveloper %}
                                        <span class="bug-card-avatar" title="{{ bug.assignedDeveloper.fullName }}">{{ bug.assignedDeveloper.fullName|slice(0,1) }}</span>
                                    {% else %}
                                        <span class="bug-card-unassigned" title="Unassigned">
                                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="12" height="12"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                        </span>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div id="view-table" style="display: none;">
        <section class="panel">
            {% if bug_reports is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon">&#128027;</div>
                    <p>No bug reports found.</p>
                </div>
            {% else %}
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Project</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Reporter</th>
                                <th>Developer</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for bug_report in bug_reports %}
                                <tr>
                                    <td>#{{ bug_report.id }}</td>
                                    <td><a href="{{ path('app_bug_report_show', {'id': bug_report.id}) }}">{{ bug_report.title }}</a></td>
                                    <td>{{ bug_report.project.name }}</td>
                                    <td><span class="badge badge-priority-{{ bug_report.priority.value }}">{{ bug_report.priority.label() }}</span></td>
                                    <td><span class="badge badge-status-{{ bug_report.status.value }}">{{ bug_report.status.label() }}</span></td>
                                    <td>{{ bug_report.reporter.fullName }}</td>
                                    <td>{{ bug_report.assignedDeveloper ? bug_report.assignedDeveloper.fullName : 'Unassigned' }}</td>
                                    <td>{{ bug_report.createdAt|date('Y-m-d') }}</td>
                                    <td><a class="btn btn-sm btn-secondary" href="{{ path('app_bug_report_show', {'id': bug_report.id}) }}">View</a></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>

    <script>
    function switchView(view) {
        document.getElementById('view-kanban').style.display = view === 'kanban' ? 'block' : 'none';
        document.getElementById('view-table').style.display = view === 'table' ? 'block' : 'none';
        document.querySelectorAll('.view-toggle-btn').forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.view === view);
        });
        if (view === 'table') {
            var table = document.querySelector('#view-table table');
            if (table && !table.classList.contains('dataTable')) {
                var actionColIdx = -1;
                table.querySelectorAll('thead th').forEach(function(th, idx) {
                    if (th.textContent.trim().toLowerCase() === 'actions') actionColIdx = idx;
                });
                var config = {
                    pageLength: 15,
                    lengthMenu: [10, 15, 25, 50],
                    order: [],
                    language: {
                        search: '',
                        searchPlaceholder: 'Search...',
                        lengthMenu: 'Show _MENU_ per page',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        paginate: { previous: '&laquo;', next: '&raquo;' },
                        emptyTable: 'No data available'
                    },
                    dom: '<"top"f>rt<"bottom"lip">',
                    columnDefs: []
                };
                if (actionColIdx >= 0) config.columnDefs.push({ orderable: false, targets: actionColIdx });
                $(table).DataTable(config);
            }
        }
    }
    </script>
{% endblock %}
