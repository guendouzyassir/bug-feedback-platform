{% extends 'base.html.twig' %}

{% block title %}Manage Bug #{{ bug_report.id }} | FixFlow{% endblock %}
{% block topbar_title %}Manage Bug #{{ bug_report.id }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Manage Bug #{{ bug_report.id }}</h1>
            <p class="muted">{{ bug_report.title }}</p>
        </div>
        <div class="actions">
            <a class="button button-secondary" href="{{ path('app_bug_report_show', {'id': bug_report.id}) }}">Back to Bug</a>
        </div>
    </div>

    <section class="panel stack">
        <dl class="meta-list" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
            <div>
                <dt>Project</dt>
                <dd>{{ bug_report.project.name }}</dd>
            </div>
            <div>
                <dt>Reporter</dt>
                <dd>{{ bug_report.reporter.fullName }}</dd>
            </div>
            <div>
                <dt>Report Date</dt>
                <dd>{{ bug_report.createdAt|date('Y-m-d H:i') }}</dd>
            </div>
            <div>
                <dt>Open Date</dt>
                <dd>{{ bug_report.openedAt ? bug_report.openedAt|date('Y-m-d H:i') : 'Not opened yet' }}</dd>
            </div>
            <div>
                <dt>Treatment Date</dt>
                <dd>{{ bug_report.treatedAt ? bug_report.treatedAt|date('Y-m-d H:i') : 'Not treated yet' }}</dd>
            </div>
        </dl>

        <div style="border-top: 1px solid var(--line-light); padding-top: 1.25rem; margin-top: .5rem;">
            <h2 style="margin-bottom: 1rem;">Update Assignment</h2>
            {{ form_start(form, {'attr': {'class': 'form'}}) }}
                {{ form_row(form.assignedDeveloper) }}
                {{ form_row(form.priority) }}
                {{ form_row(form.status) }}
                <button class="button">Save Management Changes</button>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}