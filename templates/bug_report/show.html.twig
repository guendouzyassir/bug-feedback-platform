{% extends 'base.html.twig' %}

{% block title %}{{ bug_report.title }} | FixFlow{% endblock %}
{% block topbar_title %}Bug #{{ bug_report.id }}{% endblock %}

{% block body %}
    {# ── Header ── #}
    <div class="bug-detail-header">
        <div class="bug-detail-header-main">
            <div class="bug-detail-header-top">
                <span class="bug-detail-id">#{{ bug_report.id }}</span>
                <span class="badge badge-status-{{ bug_report.status.value }}"><span class="badge-dot"></span>{{ bug_report.status.label() }}</span>
                <span class="badge badge-priority-{{ bug_report.priority.value }}"><span class="badge-dot"></span>{{ bug_report.priority.label() }}</span>
            </div>
            <h1 class="bug-detail-title">{{ bug_report.title }}</h1>
            <div class="bug-detail-meta-row">
                <span class="bug-detail-meta-item">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    {{ bug_report.project.name }}
                </span>
                <span class="bug-detail-meta-sep">&middot;</span>
                <span class="bug-detail-meta-item">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    {{ bug_report.reporter.fullName }}
                </span>
                <span class="bug-detail-meta-sep">&middot;</span>
                <span class="bug-detail-meta-item">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    {{ bug_report.createdAt|date('M d, Y') }}
                </span>
            </div>
        </div>
        <div class="bug-detail-header-actions">
            {% if can_manage %}
                <a class="button button-secondary button-sm" href="{{ path('app_bug_report_manage', {'id': bug_report.id}) }}">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Manage
                </a>
                {% include 'bug_report/_delete_form.html.twig' with {bug_report: bug_report} %}
            {% endif %}
            <a class="button button-secondary button-sm" href="{{ path('app_bug_report_index') }}">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                All Bugs
            </a>
        </div>
    </div>

    {# ── Info Cards ── #}
    <div class="bug-detail-info-grid">
        <div class="bug-detail-info-card">
            <div class="bug-detail-info-icon bug-detail-info-icon--status">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div class="bug-detail-info-data">
                <span class="bug-detail-info-label">Status</span>
                <span class="badge badge-status-{{ bug_report.status.value }}"><span class="badge-dot"></span>{{ bug_report.status.label() }}</span>
            </div>
        </div>
        <div class="bug-detail-info-card">
            <div class="bug-detail-info-icon bug-detail-info-icon--priority">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="18" height="18"><path d="M12 9v2m0 4h.01M5.07 19H18.93a2 2 0 001.723-2.986L13.723 4.014a2 2 0 00-3.446 0L3.347 16.014A2 2 0 005.07 19z"/></svg>
            </div>
            <div class="bug-detail-info-data">
                <span class="bug-detail-info-label">Priority</span>
                <span class="badge badge-priority-{{ bug_report.priority.value }}"><span class="badge-dot"></span>{{ bug_report.priority.label() }}</span>
            </div>
        </div>
        <div class="bug-detail-info-card">
            <div class="bug-detail-info-icon bug-detail-info-icon--reporter">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="18" height="18"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div class="bug-detail-info-data">
                <span class="bug-detail-info-label">Reporter</span>
                <span class="bug-detail-info-value">{{ bug_report.reporter.fullName }}</span>
            </div>
        </div>
        <div class="bug-detail-info-card">
            <div class="bug-detail-info-icon bug-detail-info-icon--developer">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="18" height="18"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <div class="bug-detail-info-data">
                <span class="bug-detail-info-label">Assigned To</span>
                {% if bug_report.assignedDeveloper %}
                    <span class="bug-detail-info-value">{{ bug_report.assignedDeveloper.fullName }}</span>
                {% else %}
                    <span class="bug-detail-info-empty">Unassigned</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="bug-detail-two-col">
        {# ── Left Column: Description + Details ── #}
        <div class="bug-detail-main-col">
            {# Description #}
            <div class="bug-detail-section">
                <h2 class="bug-detail-section-title">Description</h2>
                <div class="bug-detail-description">{{ bug_report.description|nl2br }}</div>
            </div>

            {% if bug_report.stepsToReproduce %}
                <div class="bug-detail-section">
                    <h2 class="bug-detail-section-title">Steps to Reproduce</h2>
                    <div class="bug-detail-description">{{ bug_report.stepsToReproduce|nl2br }}</div>
                </div>
            {% endif %}

            <div class="bug-detail-section-row">
                {% if bug_report.expectedResult %}
                    <div class="bug-detail-section bug-detail-section--half">
                        <h2 class="bug-detail-section-title">Expected Result</h2>
                        <div class="bug-detail-description">{{ bug_report.expectedResult|nl2br }}</div>
                    </div>
                {% endif %}
                {% if bug_report.actualResult %}
                    <div class="bug-detail-section bug-detail-section--half">
                        <h2 class="bug-detail-section-title">Actual Result</h2>
                        <div class="bug-detail-description">{{ bug_report.actualResult|nl2br }}</div>
                    </div>
                {% endif %}
            </div>

            {% if bug_report.screenshotFilename %}
                <div class="bug-detail-section">
                    <h2 class="bug-detail-section-title">Screenshot</h2>
                    <a href="{{ path('app_bug_report_screenshot', {'id': bug_report.id}) }}" target="_blank" rel="noopener">
                        <img class="screenshot-preview" src="{{ path('app_bug_report_screenshot', {'id': bug_report.id}) }}" alt="Screenshot for {{ bug_report.title }}">
                    </a>
                </div>
            {% endif %}
        </div>

        {# ── Right Column: Timeline + Status ── #}
        <div class="bug-detail-side-col">
            {# Timeline #}
            <div class="bug-detail-section">
                <h2 class="bug-detail-section-title">Timeline</h2>
                <div class="bug-detail-timeline">
                    <div class="bug-detail-timeline-item">
                        <div class="bug-detail-timeline-dot bug-detail-timeline-dot--reported"></div>
                        <div class="bug-detail-timeline-content">
                            <span class="bug-detail-timeline-label">Reported</span>
                            <span class="bug-detail-timeline-date">{{ bug_report.createdAt|date('M d, Y') }}</span>
                            <span class="bug-detail-timeline-time">{{ bug_report.createdAt|date('H:i') }}</span>
                        </div>
                    </div>
                    <div class="bug-detail-timeline-item {{ bug_report.openedAt ? '' : 'bug-detail-timeline-item--pending' }}">
                        <div class="bug-detail-timeline-dot {{ bug_report.openedAt ? 'bug-detail-timeline-dot--opened' : '' }}"></div>
                        <div class="bug-detail-timeline-content">
                            <span class="bug-detail-timeline-label">Opened</span>
                            {% if bug_report.openedAt %}
                                <span class="bug-detail-timeline-date">{{ bug_report.openedAt|date('M d, Y') }}</span>
                                <span class="bug-detail-timeline-time">{{ bug_report.openedAt|date('H:i') }}</span>
                            {% else %}
                                <span class="bug-detail-timeline-pending">Pending</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="bug-detail-timeline-item {{ bug_report.treatedAt ? '' : 'bug-detail-timeline-item--pending' }}">
                        <div class="bug-detail-timeline-dot {{ bug_report.treatedAt ? 'bug-detail-timeline-dot--treated' : '' }}"></div>
                        <div class="bug-detail-timeline-content">
                            <span class="bug-detail-timeline-label">Treatment</span>
                            {% if bug_report.treatedAt %}
                                <span class="bug-detail-timeline-date">{{ bug_report.treatedAt|date('M d, Y') }}</span>
                                <span class="bug-detail-timeline-time">{{ bug_report.treatedAt|date('H:i') }}</span>
                            {% else %}
                                <span class="bug-detail-timeline-pending">Pending</span>
                            {% endif %}
                        </div>
                    </div>
                    {% if bug_report.closedAt %}
                        <div class="bug-detail-timeline-item">
                            <div class="bug-detail-timeline-dot bug-detail-timeline-dot--closed"></div>
                            <div class="bug-detail-timeline-content">
                                <span class="bug-detail-timeline-label">Closed</span>
                                <span class="bug-detail-timeline-date">{{ bug_report.closedAt|date('M d, Y') }}</span>
                                <span class="bug-detail-timeline-time">{{ bug_report.closedAt|date('H:i') }}</span>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Update Status #}
            {% if status_form %}
                <div class="bug-detail-section">
                    <h2 class="bug-detail-section-title">Update Status</h2>
                    {{ form_start(status_form, {'attr': {'class': 'bug-detail-status-form'}}) }}
                        <div class="bug-detail-status-row">
                            {{ form_widget(status_form.status) }}
                            <button class="button button-sm">Update Status</button>
                        </div>
                    {{ form_end(status_form) }}
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Comments ── #}
    <div class="bug-detail-section bug-detail-comments-section">
        <h2 class="bug-detail-section-title">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="16" height="16"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            Comments
            {% if bug_report.comments is not empty %}
                <span class="bug-detail-comment-count">{{ bug_report.comments|length }}</span>
            {% endif %}
        </h2>

        {{ form_start(comment_form, {'attr': {'class': 'bug-detail-comment-form'}}) }}
            {{ form_row(comment_form.content) }}
            <div class="bug-detail-comment-form-actions">
                <button class="button button-sm">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14" height="14"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                    Add Comment
                </button>
            </div>
        {{ form_end(comment_form) }}

        {% if bug_report.comments is empty %}
            <div class="bug-detail-empty-comments">
                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="28" height="28"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <p>No comments yet</p>
                <span>Be the first to leave a comment on this bug.</span>
            </div>
        {% else %}
            <div class="bug-detail-comment-list">
                {% for comment in bug_report.comments %}
                    <article class="bug-detail-comment">
                        <div class="bug-detail-comment-avatar">
                            {{ comment.author.fullName|slice(0,1) }}
                        </div>
                        <div class="bug-detail-comment-body">
                            <div class="bug-detail-comment-header">
                                <strong class="bug-detail-comment-author">{{ comment.author.fullName }}</strong>
                                <time class="bug-detail-comment-time">{{ comment.createdAt|date('M d, Y \a\t H:i') }}</time>
                            </div>
                            <div class="bug-detail-comment-text">{{ comment.content|nl2br }}</div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
