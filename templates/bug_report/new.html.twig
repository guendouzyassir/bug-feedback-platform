{% extends 'base.html.twig' %}

{% block title %}New Bug Report | FixFlow{% endblock %}
{% block topbar_title %}New Bug Report{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="muted">Describe the issue clearly so the development team can reproduce it.</p>
        </div>
        <a class="button button-secondary" href="{{ path('app_bug_report_index') }}">Back to Bugs</a>
    </div>

    <section class="panel">
        {{ form_start(form, {'attr': {'class': 'form'}}) }}
            {{ form_row(form.project) }}
            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
            {{ form_row(form.stepsToReproduce) }}
            {{ form_row(form.expectedResult) }}
            {{ form_row(form.actualResult) }}
            {{ form_row(form.priority) }}
            {{ form_row(form.screenshot) }}
            <button class="button">Create Bug Report</button>
        {{ form_end(form) }}
    </section>
{% endblock %}