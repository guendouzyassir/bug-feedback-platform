<form method="post" action="{{ path('app_bug_report_delete', {'id': bug_report.id}) }}" data-confirm="Delete this bug report?" data-confirm-title="Delete Bug Report?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bug_report.id) }}">
    <button class="btn btn-sm btn-danger">Delete</button>
</form>
