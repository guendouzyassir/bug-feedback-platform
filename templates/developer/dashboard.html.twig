{% extends 'base.html.twig' %}

{% block title %}Developer Dashboard | FixFlow{% endblock %}
{% block topbar_title %}Developer Dashboard{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="muted">Report and work on bugs in the projects assigned to you.</p>
        </div>
        <a class="btn" href="{{ path('app_bug_report_index') }}">View My Bugs</a>
    </div>

    <section class="grid">
        <article class="metric">
            <div class="metric-label">Bugs in My Projects</div>
            <span class="metric-value">{{ projectBugCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Open</div>
            <span class="metric-value">{{ openCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">In Progress</div>
            <span class="metric-value">{{ inProgressCount }}</span>
        </article>
        <article class="metric">
            <div class="metric-label">Fixed</div>
            <span class="metric-value">{{ fixedCount }}</span>
        </article>
    </section>

    <section class="panel" style="margin-top: 1.25rem;">
        <h2>My Projects</h2>
        {% if assignedProjects is empty %}
            <p class="muted">No projects assigned yet. Ask an administrator to assign you to a project.</p>
        {% else %}
            <div class="quick-actions">
                {% for project in assignedProjects %}
                    <a class="quick-action" href="{{ path('app_bug_report_index', {'project': project.id}) }}">
                        <strong>{{ project.name }}</strong>
                        <span class="muted">{{ project.platform }} &middot; {{ project.isActive ? 'Active' : 'Inactive' }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="quick-actions" style="margin-top: .75rem;">
        <a class="quick-action" href="{{ path('app_bug_report_index') }}">
            <strong>All My Bugs</strong>
            <span class="muted">View all bugs in your assigned projects.</span>
        </a>
        <a class="quick-action" href="{{ path('app_bug_report_index', {'status': 'open'}) }}">
            <strong>Open Bugs</strong>
            <span class="muted">Bugs waiting to be picked up.</span>
        </a>
        <a class="quick-action" href="{{ path('app_bug_report_index', {'status': 'in_progress'}) }}">
            <strong>In Progress</strong>
            <span class="muted">Continue active development work.</span>
        </a>
    </section>
{% endblock %}
