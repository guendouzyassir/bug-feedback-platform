<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}FixFlow{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    {% endblock %}
</head>
<body>
    {% if app.user %}
    {% set actualRoles = app.user.roles %}
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="document.getElementById('sidebar').classList.remove('open');this.classList.remove('active');"></div>
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" href="{{ path('app_home') }}">
            <span class="sidebar-brand-text">
                FixFlow
                <small>Bug Feedback & Issue Tracking</small>
            </span>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <div class="sidebar-section-label">Main</div>
                {% set currentRoute = app.request.attributes.get('_route') %}
                {% if 'ROLE_ADMIN' in actualRoles %}
                    <a class="sidebar-link {{ currentRoute == 'admin_dashboard' ? 'active' : '' }}" href="{{ path('admin_dashboard') }}">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        <span>Dashboard</span>
                    </a>
                {% elseif 'ROLE_DEVELOPER' in actualRoles %}
                    <a class="sidebar-link {{ currentRoute == 'developer_dashboard' ? 'active' : '' }}" href="{{ path('developer_dashboard') }}">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        <span>Dashboard</span>
                    </a>
                {% elseif 'ROLE_CLIENT' in actualRoles %}
                    <a class="sidebar-link {{ currentRoute == 'client_dashboard' ? 'active' : '' }}" href="{{ path('client_dashboard') }}">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        <span>Dashboard</span>
                    </a>
                {% endif %}
                <a class="sidebar-link {{ currentRoute starts with 'app_bug_report' ? 'active' : '' }}" href="{{ path('app_bug_report_index') }}">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Bug Reports</span>
                </a>
                {% if 'ROLE_CLIENT' in actualRoles or 'ROLE_ADMIN' in actualRoles or 'ROLE_DEVELOPER' in actualRoles %}
                    <a class="sidebar-link {{ currentRoute == 'app_bug_report_new' ? 'active' : '' }}" href="{{ path('app_bug_report_new') }}">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                        <span>New Bug</span>
                    </a>
                {% endif %}
            </div>

            {% if 'ROLE_ADMIN' in actualRoles %}
            <div class="sidebar-section">
                <div class="sidebar-section-label">Management</div>
                <a class="sidebar-link {{ currentRoute starts with 'app_admin_project' ? 'active' : '' }}" href="{{ path('app_admin_project_index') }}">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    <span>Projects</span>
                </a>
                <a class="sidebar-link {{ currentRoute starts with 'app_admin_user' ? 'active' : '' }}" href="{{ path('app_admin_user_index') }}">
                    <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                    <span>Users</span>
                </a>
            </div>
            {% endif %}
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <span class="sidebar-avatar">{{ app.user.fullName|slice(0,1) }}</span>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">{{ app.user.fullName }}</div>
                    <div class="sidebar-user-role">
                        {% if 'ROLE_ADMIN' in actualRoles %}Admin{% elseif 'ROLE_DEVELOPER' in actualRoles %}Developer{% else %}Client{% endif %}
                    </div>
                </div>
            </div>
            <a class="sidebar-logout" href="{{ path('app_logout') }}">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                <span>Sign out</span>
            </a>
        </div>
    </aside>
    {% endif %}

    <div class="main{% if not app.user %} main--full{% endif %}">
        {% if app.user %}
        <header class="topbar">
            <div class="topbar-left">
                <button class="sidebar-toggle" onclick="var s=document.getElementById('sidebar');var o=document.getElementById('sidebarOverlay');s.classList.toggle('open');if(s.classList.contains('open')){o.classList.add('active')}else{o.classList.remove('active')}" aria-label="Toggle sidebar">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20" height="20"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <a class="topbar-brand" href="{{ path('app_home') }}">
                    <span class="topbar-brand-text">FixFlow</span>
                </a>
                <div class="topbar-divider"></div>
                <h1 class="topbar-title">{% block topbar_title %}Dashboard{% endblock %}</h1>
            </div>
            <div class="topbar-right"></div>
        </header>
        {% endif %}

        <main class="container">
            {% block body %}{% endblock %}
        </main>
    </div>

    <script>window.flashMessages = {{ app.flashes|json_encode|raw }};</script>
</body>
</html>